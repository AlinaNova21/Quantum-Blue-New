cmd-chameleonify-desc = Turns a piece of clothing into chameleon clothing, so its look can be changed with the "Chameleon" verb.
cmd-chameleonify-help = Usage: {$command} <entity uid> [default prototype] [slot]
    default prototype: what it looks like right away (defaults to its own prototype).
    slot: which slot's clothing to show in the menu, e.g. BACK (defaults to the item's own slot).
cmd-chameleonify-not-clothing = {$entity} is not clothing that can be worn in a slot.
cmd-chameleonify-bad-slot = "{$slot}" is not a valid single clothing slot (try BACK, HEAD, MASK...).
cmd-chameleonify-bad-default = {$prototype} can't be used as a chameleon appearance for slot {$slot}. It must be clothing for that slot with the WhitelistChameleon tag.
cmd-chameleonify-success = {$entity} is now chameleon clothing ({$slot}). Right-click it and use the "Chameleon" verb.
cmd-chameleonify-hint-entity = <entity uid>
cmd-chameleonify-hint-default = [default prototype]
cmd-chameleonify-hint-slot = [slot]
